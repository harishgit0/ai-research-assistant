# Copy to .env in the repository root.
AI_RESEARCH_DB_NAME=ai_research_assistant
AI_RESEARCH_DB_USER=postgres
AI_RESEARCH_DB_PASSWORD=change-me
AI_RESEARCH_DB_HOST=localhost
AI_RESEARCH_DB_PORT=5432

# Use mock for a no-key UI smoke test; Gemini is needed for real answers.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
